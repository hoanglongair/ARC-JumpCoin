{
  "name": "arc-jumpcoin",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @arc-jumpcoin/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @arc-jumpcoin/web db:generate",
    "db:migrate": "pnpm --filter @arc-jumpcoin/web db:migrate",
    "contracts:compile": "pnpm --filter @arc-jumpcoin/contracts compile",
    "contracts:test": "pnpm --filter @arc-jumpcoin/contracts test",
    "contracts:deploy": "pnpm --filter @arc-jumpcoin/contracts deploy"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
